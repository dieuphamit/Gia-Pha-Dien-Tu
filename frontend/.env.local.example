# ============================================================
# Gia Phả Điện Tử — Environment Variables
# ============================================================
# Copy this file to .env.local and replace with your own values:
#   cp .env.local.example .env.local
#
# Get your keys from: Supabase Dashboard → Settings → API
# ============================================================

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Anonymous Key (safe to expose in client-side code)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (⚠️ SECRET — server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Email (Resend) ───────────────────────────────────────────────
# Lấy API key tại: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Địa chỉ email gửi:
#   - Nếu đã verify domain trên Resend: EMAIL_FROM=noreply@yourdomain.com
#   - Nếu chưa verify domain (free tier): bỏ trống hoặc dùng onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev

# URL public của app (dùng trong link email)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ── Local Dev Only ───────────────────────────────────────────────
# Chuyển hướng TẤT CẢ email về địa chỉ này khi test ở local.
# ⚠️ KHÔNG set biến này trên production (Vercel) — để trống để gửi đúng người nhận.
EMAIL_TEST_RECIPIENT=your_dev_email@gmail.com

# ── Cron Job Security ────────────────────────────────────────────
# Token bí mật để bảo vệ /api/cron/birthday
# Tạo bằng: openssl rand -hex 32
CRON_SECRET=your_random_secret_here
